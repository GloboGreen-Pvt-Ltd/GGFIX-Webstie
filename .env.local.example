# Every base EXCEPT master keeps a /<service> SUFFIX. The api.ggfix.in nginx edge
# strips that prefix before forwarding, and src/lib/api.js adds the service name
# again at the call site, so the wire URL contains it twice:
#   AUTH_BASE + '/auth/login' -> https://api.ggfix.in/auth/auth/login
# master-data is special-cased at the edge (location /master/ -> :8091/master/), so
# its base is the bare host and the path stays clean:
#   MASTER_BASE + '/master/brands' -> https://api.ggfix.in/master/brands  (200)
# No trailing slash.
NEXT_PUBLIC_MASTER_DATA_BASE=https://api.ggfix.in
NEXT_PUBLIC_API_BASE=https://api.ggfix.in
NEXT_PUBLIC_AUTH_BASE=https://api.ggfix.in/auth
NEXT_PUBLIC_SHOP_BASE=https://api.ggfix.in/shop
NEXT_PUBLIC_SUBSCRIPTION_BASE=https://api.ggfix.in/subscription
NEXT_PUBLIC_TICKET_BASE=https://api.ggfix.in/ticket

# Google Maps JS API key, browser-restricted (HTTP referrer) to this site's
# domain(s). Maps JavaScript API + Places API (New) only — NOT Geocoding,
# which stays server-side (see GOOGLE_GEOCODING_API_KEY in the backend repo).
# Baked into the static export at BUILD time (output:'export'), so it is
# public in the shipped bundle by design — that's what the referrer
# restriction is for.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# SEO & analytics (all optional) — see src/lib/seo.js and
# src/components/seo/Analytics.js. Baked in at build time like every
# NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------------------
# Canonical origin used in canonical tags, og:url, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://ggfix.in
# Set to "false" on dev/preview builds so they are noindex and robots-blocked.
# Leave unset (or "true") for production.
# NEXT_PUBLIC_ALLOW_INDEXING=false
# Google Search Console "HTML tag" verification code (the content="" value only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement id (G-...). Use this OR GTM, not both.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager container id (GTM-...).
# NEXT_PUBLIC_GTM_ID=
